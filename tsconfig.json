{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "tests",
    "pages",
    "fixtures",
    "utils",
    "reporters",
    "*.ts"
  ]
}
